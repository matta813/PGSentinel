{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "dependencyDashboard": true,
  "dependencyDashboardTitle": "Dependency Dashboard",
  "enabledManagers": ["gomod", "npm", "dockerfile", "docker-compose", "gitlabci"],
  "ignorePaths": ["RELEASE"],
  "labels": ["dependencies", "renovate"],
  "branchPrefix": "renovate/",
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "rangeStrategy": "auto",
  "minimumReleaseAge": "3 days",
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "timezone": "Europe/Zurich",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 5am on the first day of the month"],
    "automerge": false
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["dependencies", "renovate", "security"],
    "prPriority": 10,
    "minimumReleaseAge": null
  },
  "packageRules": [
    {
      "description": "Automerge patch, digest and pin updates only after GitLab CI succeeds",
      "matchUpdateTypes": ["patch", "digest", "pin", "pinDigest"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "description": "Require human review for minor updates",
      "matchUpdateTypes": ["minor"],
      "automerge": false
    },
    {
      "description": "Require Dependency Dashboard approval for major updates",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true,
      "automerge": false
    },
    {
      "description": "Group frontend runtime patch updates",
      "matchManagers": ["npm"],
      "matchDepTypes": ["dependencies", "peerDependencies"],
      "matchUpdateTypes": ["patch"],
      "groupName": "frontend patch dependencies",
      "addLabels": ["dependencies::frontend", "update::patch"]
    },
    {
      "description": "Group frontend development patch updates",
      "matchManagers": ["npm"],
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["patch"],
      "groupName": "frontend development dependencies",
      "addLabels": ["dependencies::frontend", "update::patch"]
    },
    {
      "description": "Group Go patch updates",
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["patch"],
      "groupName": "go patch dependencies",
      "addLabels": ["dependencies::go", "update::patch"]
    },
    {
      "description": "Group Dockerfile and Compose patch updates",
      "matchManagers": ["dockerfile", "docker-compose"],
      "matchUpdateTypes": ["patch", "digest"],
      "groupName": "docker base image patches",
      "addLabels": ["dependencies::docker", "update::patch"]
    },
    {
      "description": "Group GitLab CI image patch updates",
      "matchManagers": ["gitlabci"],
      "matchUpdateTypes": ["patch", "digest"],
      "groupName": "gitlab ci tooling",
      "addLabels": ["dependencies::ci", "update::patch"]
    },
    {
      "description": "Label minor updates",
      "matchUpdateTypes": ["minor"],
      "addLabels": ["update::minor"]
    },
    {
      "description": "Label major updates",
      "matchUpdateTypes": ["major"],
      "addLabels": ["update::major"]
    }
  ]
}
