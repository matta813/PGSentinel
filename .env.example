PGSENTINEL_LISTEN_ADDR=:8080
PGSENTINEL_DATA_DIR=./data
# Generate with: openssl rand -base64 32
PGSENTINEL_ENCRYPTION_KEY=
# Minimum 12 characters. Keep this value out of source control.
PGSENTINEL_ADMIN_PASSWORD=
PGSENTINEL_SECURE_COOKIES=false
# Comma-separated CIDRs of reverse proxies whose X-Forwarded-For header is trusted.
PGSENTINEL_TRUSTED_PROXY_CIDRS=
# Comma-separated exact hostnames for self-hosted ntfy/webhook targets.
PGSENTINEL_NOTIFICATION_ALLOWED_HOSTS=
PGSENTINEL_ALLOW_PRIVATE_NOTIFICATION_TARGETS=false
PGSENTINEL_LOG_LEVEL=info
PGSENTINEL_VERSION=0.7.0
PGSENTINEL_STATS_INTERVAL=30s
# Full JSON snapshots are capped per server/resource as well as by age.
PGSENTINEL_RETENTION=720h
PGSENTINEL_MAX_SNAPSHOTS_PER_RESOURCE=120
# Bounded local history: raw, 15-minute, and 6-hour metric tiers.
PGSENTINEL_METRIC_RAW_RETENTION=24h
PGSENTINEL_METRIC_MEDIUM_RETENTION=720h
PGSENTINEL_METRIC_LONG_RETENTION=8760h
TZ=Europe/Zurich
